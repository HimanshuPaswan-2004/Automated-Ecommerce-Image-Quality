# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Type Checking
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Image Storage / Uploads / Temporary artifacts
backend/storage/
backend/uploads/
storage/
uploads/

# Large Raw Datasets (track structure, ignore raw bulk dumps)
dataset/raw/*
!dataset/raw/.gitkeep
dataset/processed/*
!dataset/processed/.gitkeep
dataset/synthetic/*
!dataset/synthetic/.gitkeep

# IDEs & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

